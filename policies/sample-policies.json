      "vhost": "/"
    },
    {
      "apply-to": "classic_queues",
      "definition": {
        "message-ttl": 60000
      },
      "name": "cq-ttl-policy",
      "pattern": "^cq-ttl-.*",
      "priority": 0,
      "vhost": "/"
    }
  ],
